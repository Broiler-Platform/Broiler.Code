<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Code: nuget.org only, for the Broiler.* packages as for
    everything else.

    <clear /> drops whatever sources the machine happens to have configured, so a
    restore resolves the same way on every developer box and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>

  <!--
    Every package, Broiler.* included, maps to nuget.org. There is no second feed and no
    credential to supply.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
