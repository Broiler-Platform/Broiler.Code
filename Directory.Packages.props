<Project>
  <!--
    Central Package Management: every NuGet package version this repository's projects
    reference is set here, and the PackageReference items carry no Version of their own.

    MSBuild uses the NEAREST Directory.Packages.props walking up from a project, so this
    file also shields the projects here from the Broiler monorepo's own one when the
    repository is checked out as its submodule.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerUiVersion>0.1.0-preview.20</BroilerUiVersion>
    <BroilerGraphicsVersion>0.1.0-preview.12</BroilerGraphicsVersion>
    <BroilerInputVersion>0.1.0-preview.6</BroilerInputVersion>
    <BroilerHostingVersion>0.1.0-preview.9</BroilerHostingVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.13" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Hosting.Windows" Version="0.1.0-preview.10" />
    <PackageVersion Include="Broiler.Hosting.Linux" Version="$(BroilerHostingVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Linux" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.UI" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Button" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.CodeEditor" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.ComboBox" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Edit" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Label" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Menu" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Panel" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Splitter" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.TabView" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Toolbar" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.TreeView" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.CodeEditor.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.ComboBox.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Edit.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Menu.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Splitter.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.TabView.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.UI.TreeView.Standard" Version="0.1.0-preview.22" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>