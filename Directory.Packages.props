<Project>
  <!--
    Central Package Management: every NuGet package version this repository's projects
    reference is set here, and the PackageReference items carry no Version of their own.

    MSBuild uses the NEAREST Directory.Packages.props walking up from a project, so this
    file also shields the projects here from the Broiler monorepo's own one when the
    repository is checked out as its submodule.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerUiVersion>0.1.0-preview.18</BroilerUiVersion>
    <BroilerGraphicsVersion>0.1.0-preview.7</BroilerGraphicsVersion>
    <BroilerInputVersion>0.1.0-preview.5</BroilerInputVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Graphics.Windows" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.UI.Button" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.CodeEditor" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.ComboBox" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Edit" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Label" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Menu" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Panel" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Splitter" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.TabView" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Toolbar" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.TreeView" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.CodeEditor.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.ComboBox.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Edit.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Menu.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Splitter.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.TabView.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.TreeView.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>
