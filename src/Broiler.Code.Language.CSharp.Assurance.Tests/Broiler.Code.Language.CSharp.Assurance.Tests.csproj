<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Code.Language.CSharp.Assurance.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!--
    The scanner-agreement tests. They used to sit in Broiler.Code.Language.CSharp.Tests,
    which also references the editor's syntax and language-service projects, so they
    could only run when those built. Here they need the scanner and the review model
    and nothing else.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Broiler.Code.Language.CSharp.Assurance\Broiler.Code.Language.CSharp.Assurance.csproj" />
    <ProjectReference Include="..\Broiler.Code.Review\Broiler.Code.Review.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
