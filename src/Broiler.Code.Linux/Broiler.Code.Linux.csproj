<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Broiler.Code.Linux</RootNamespace>
    <AssemblyName>Broiler.Code.Linux</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Release-Linux'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The X11 clipboard, shared with the Browser and Writer heads. -->
  <ItemGroup>
    <Compile Include="..\Broiler.App\LinuxX11Clipboard.cs" Link="LinuxX11Clipboard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Linux.OpenGL" />
    <PackageReference Include="Broiler.Input.Keyboard.Linux" />
    <PackageReference Include="Broiler.Input.Mouse.Linux" />
    <PackageReference Include="Broiler.UI.Button.Standard" />
    <PackageReference Include="Broiler.UI.CodeEditor.Standard" />
    <PackageReference Include="Broiler.UI.ComboBox.Standard" />
    <PackageReference Include="Broiler.UI.Edit.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.Menu.Standard" />
    <PackageReference Include="Broiler.UI.Panel.Standard" />
    <PackageReference Include="Broiler.UI.Splitter.Standard" />
    <PackageReference Include="Broiler.UI.TabView.Standard" />
    <PackageReference Include="Broiler.UI.Toolbar.Standard" />
    <PackageReference Include="Broiler.UI.TreeView.Standard" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The C# semantic assembly, for the review pane's assurance scanner: finding
      the code units of a file and fingerprinting them the way the component that
      owns the annotation format does needs a real parser, and an approximate one
      would report every reviewed declaration in a repository as stale.

      Roslyn reaching a desktop head is the arrangement the architecture plans
      for. What Phase 0's payload probes measured, and what
      CodeEditorArchitectureTests still asserts, is that it stays out of
      Broiler.Code.Core's closure — so a browser or Android head composes the
      portable classifier alone. This reference is in the head, which is where
      that decision says a language service belongs.
    -->
    <ProjectReference Include="..\Broiler.Code.Language.CSharp.Roslyn\Broiler.Code.Language.CSharp.Roslyn.csproj" />
    <ProjectReference Include="..\Broiler.Code.Core\Broiler.Code.Core.csproj" />
  </ItemGroup>

</Project>
