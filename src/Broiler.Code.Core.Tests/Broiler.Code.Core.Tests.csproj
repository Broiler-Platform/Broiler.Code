<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Code.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Broiler.Graphics" />
    <PackageReference Include="Broiler.UI" />
    <PackageReference Include="Broiler.UI.Button.Standard" />
    <PackageReference Include="Broiler.UI.CodeEditor.Standard" />
    <PackageReference Include="Broiler.UI.ComboBox.Standard" />
    <PackageReference Include="Broiler.UI.Edit.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.Menu.Standard" />
    <PackageReference Include="Broiler.UI.Panel.Standard" />
    <PackageReference Include="Broiler.UI.Splitter.Standard" />
    <PackageReference Include="Broiler.UI.TabView.Standard" />
    <PackageReference Include="Broiler.UI.Toolbar.Standard" />
    <PackageReference Include="Broiler.UI.TreeView.Standard" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Code.Core\Broiler.Code.Core.csproj" />
    <ProjectReference Include="..\Broiler.Code.Workspaces\Broiler.Code.Workspaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Broiler.Graphics" />
    <Using Include="Broiler.Graphics.Geometry" />
    <Using Include="Broiler.Graphics.RenderList" />
  </ItemGroup>

</Project>
