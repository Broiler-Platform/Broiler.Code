<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Broiler.Code.Core</RootNamespace>
    <AssemblyName>Broiler.Code.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The seam described in docs/architecture/broiler-code.md: this assembly
    adapts workspace snapshots to the control-facing CodeEditor interfaces. It
    is the only place that knows about both, which is what keeps the control
    independent of a product workspace and the workspace independent of UI
    packages. Phase 2 adds the shell here; Phase 1 adds only the adapter and the
    analysis controller.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Broiler.Code.Workspaces\Broiler.Code.Workspaces.csproj" />
    <ProjectReference Include="..\Broiler.Code.Review\Broiler.Code.Review.csproj" />

    <!--
      For the review pane's note-kind picker. The abstraction only: which control
      a head builds is still the head's decision, and a head that supplies none
      composes the pane exactly as it did before.
    -->
    <!--
      Shell composition. Abstractions only: the head chooses implementations,
      which is what keeps the shell hostable anywhere and testable with none.
    -->
    <!-- The review pane's note field. Single-line; see CodeShellControls.ReviewNoteInput. -->
    <!--
      Input and Graphics for the shared desktop input routing. Both are
      platform-neutral contract assemblies, not backends: a platform backend
      here would defeat the point of the heads being thin.
    -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Code.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.UI.Button" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.CodeEditor" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.ComboBox" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Edit" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Label" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Menu" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Panel" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Splitter" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.TabView" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.Toolbar" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.UI.TreeView" Version="0.1.0-preview.4" />
  </ItemGroup>

</Project>
